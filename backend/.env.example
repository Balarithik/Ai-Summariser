# --- LLM provider ---
# Which backend to use: openai | gemini
LLM_PROVIDER=gemini

# --- Gemini (when LLM_PROVIDER=gemini) ---
# Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible endpoint
# OPENAI_BASE_URL=

# --- Shared LLM settings ---
TEMPERATURE=0
LLM_REQUEST_TIMEOUT=60
# Max retries for transient errors (rate limits, timeouts).
# Quota exhaustion is NOT retried.
LLM_MAX_RETRIES=2
# Max outbound LLM calls per second across the process (0 = unlimited).
# For free-tier providers, use 0.25 (15 calls/minute) or lower.
LLM_REQUESTS_PER_SECOND=0.25

# --- Chunking ---
CHUNK_SIZE=4000
CHUNK_OVERLAP=400

# --- Concurrency ---
# Max simultaneous chunk-processing tasks.
# For free-tier providers, use 1 to avoid rate limits.
MAX_CONCURRENCY=1

# --- Input validation ---
MIN_ARTICLE_WORDS=40
MAX_ARTICLE_CHARS=200000

# --- URL loading ---
URL_FETCH_TIMEOUT=10

# --- API rate limiting (per client IP, POST /api/v1/summarize) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Only true behind a trusted reverse proxy that sets X-Forwarded-For
RATE_LIMIT_TRUST_PROXY=false

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-article-summarizer

# --- API / CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
LOG_LEVEL=INFO
ENVIRONMENT=development
