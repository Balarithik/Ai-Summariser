# --- LLM provider ---
# Which backend to use: openai | gemini
LLM_PROVIDER=openai

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o-mini

# Gemini (when LLM_PROVIDER=gemini) - key from Google AI Studio
# GEMINI_API_KEY is also accepted as an alias.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared
TEMPERATURE=0
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
# Max outbound LLM calls per second across the process (0 = unlimited).
# Handy for provider free-tier quotas, e.g. 0.25 = 15 calls/minute.
LLM_REQUESTS_PER_SECOND=0

# --- Chunking ---
CHUNK_SIZE=4000
CHUNK_OVERLAP=400

# --- Concurrency ---
MAX_CONCURRENCY=4

# --- Input validation ---
MIN_ARTICLE_WORDS=40
MAX_ARTICLE_CHARS=200000

# --- URL loading ---
URL_FETCH_TIMEOUT=10

# --- API rate limiting (per client IP, POST /api/v1/summarize) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Only true behind a trusted reverse proxy that sets X-Forwarded-For
RATE_LIMIT_TRUST_PROXY=false

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-article-summarizer

# --- API / CORS ---
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
LOG_LEVEL=INFO
ENVIRONMENT=development
